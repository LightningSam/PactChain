{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/workspace",
      "destination": "/app.html"
    },
    {
      "source": "/main",
      "destination": "/index.html"
    }
  ]
}
